BT 1 0 0 1 0 242.08 Tm /F3 6.8 Tf 8.296 TL (#include <stdio.h>) Tj T* (#include <stddef.h>) Tj T* (#include <string.h>) Tj T*  T* (#define MAX_PATIENTS 100) Tj T*  T* (typedef struct { int day, month, year; } Date;) Tj T* (typedef struct { int systolic, diastolic; } BloodPressure;) Tj T*  T* (typedef struct {) Tj T* (    char name[40];) Tj T* (    char phone[16];       /* room for 15 characters plus '\\0' */) Tj T* (    int age;) Tj T* (    BloodPressure bp;) Tj T* (    Date visit_date;) Tj T* (} Patient;) Tj T*  T* (typedef struct {) Tj T* (    Patient records[MAX_PATIENTS];) Tj T* (    size_t count;) Tj T* (} PatientRegistry;) Tj T*  T* (static int valid_date\(Date d\)) Tj T* ({) Tj T* (    static const int days_in_month[] =) Tj T* (        {0,31,28,31,30,31,30,31,31,30,31,30,31};) Tj T* (    int limit;) Tj T* (    if \(d.year < 1 || d.month < 1 || d.month > 12 || d.day < 1\)) Tj T* (        return 0;) Tj T* (    limit = days_in_month[d.month];) Tj T* ET

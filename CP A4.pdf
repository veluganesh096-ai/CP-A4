BT 1 0 0 1 0 329.82 Tm /F3 6.9 Tf 8.418 TL (#include <stdio.h>) Tj T*  T* (struct account { int number; float balance; };) Tj T*  T* (/* Address evidence for the pass-by-value version. */) Tj T* (void addInterest\(struct account a, float rate\)) Tj T* ({) Tj T* (    printf\("address inside by-value function: %p\\n", \(void *\)&a\);) Tj T* (    a.balance = a.balance + a.balance * rate / 100.0f;) Tj T* (}) Tj T*  T* (/* Correct version: pointer lets the function modify the caller's object. */) Tj T* (void addInterest_pointer\(struct account *a, float rate\)) Tj T* ({) Tj T* (    if \(a == NULL\) return;) Tj T* (    a->balance = a->balance + a->balance * rate / 100.0f;) Tj T* (}) Tj T*  T* (int main\(void\)) Tj T* ({) Tj T* (    struct account list[3] = {) Tj T* (        {101, 5000.0f}, {102, 12000.0f}, {103, 800.0f}) Tj T* (    };) Tj T* (    struct account *p = list;) Tj T* (    int i;) Tj T*  T* (    printf\("address in main: %p\\n", \(void *\)&list[0]\);) Tj T* (    addInterest\(list[0], 4.0f\);) Tj T*  T* (    for \(i = 0; i < 3; ++i\)) Tj T* (        addInterest_pointer\(&list[i], 4.0f\);) Tj T*  T* (    for \(i = 0; i < 3; ++i\)) Tj T* (        printf\("%d %.2f\\n", p[i].number, p[i].balance\);) Tj T*  T* (    /* Correct pointer-member access uses ->, not p.number. */) Tj T* (    printf\("first account via pointer: %d %.2f\\n",) Tj T* (           p->number, p->balance\);) Tj T* (    return 0;) Tj T* (}) Tj T* ET

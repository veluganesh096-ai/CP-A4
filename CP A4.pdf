1 0 0 1 51.35433 131.5521 cm
%PreformattedPara
.090196 .129412 .168627 rg
BT 1 0 0 1 0 124.56 Tm /F3 7.2 Tf 8.784 TL (ALGORITHM SortParcelsByWeight\(P, n\)) Tj T* (    FOR i <- 0 TO n - 2) Tj T* (        minIndex <- i) Tj T* (        FOR j <- i + 1 TO n - 1) Tj T* (            IF P[j].weight < P[minIndex].weight THEN) Tj T* (                minIndex <- j) Tj T* (            END IF) Tj T* (        END FOR) Tj T* (        IF minIndex != i THEN) Tj T* (            temp <- P[i]) Tj T* (            P[i] <- P[minIndex]) Tj T* (            P[minIndex] <- temp) Tj T* (        END IF) Tj T* (    END FOR) Tj T* (END ALGORITHM) Tj T* ET
Q
 


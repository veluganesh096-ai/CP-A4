.090196 .129412 .168627 rg
BT 1 0 0 1 0 424.592 Tm /F3 6.8 Tf 8.296 TL (#include <stdio.h>) Tj T*  T* (struct date { int day, month, year; };) Tj T* (struct address { char city[20]; int pincode; };) Tj T* (struct parcel {) Tj T* (    int id;) Tj T* (    float weight;) Tj T* (    struct address to;) Tj T* (    struct date booked;) Tj T* (};) Tj T*  T* (void print_parcel\(const struct parcel *p\)) Tj T* ({) Tj T* (    if \(p == NULL\) return;) Tj T* (    printf\("%d %.1f kg %s-%d %02d/%02d/%04d\\n",) Tj T* (           p->id, p->weight, p->to.city, p->to.pincode,) Tj T* (           p->booked.day, p->booked.month, p->booked.year\);) Tj T* (}) Tj T*  T* (/* Selection sort: ascending parcel weight. */) Tj T* (void sort_by_weight\(struct parcel p[], int n\)) Tj T* ({) Tj T* (    int i;) Tj T* (    for \(i = 0; i < n - 1; ++i\) {) Tj T* (        int min_index = i;) Tj T* (        int j;) Tj T* (        for \(j = i + 1; j < n; ++j\) {) Tj T* (            if \(p[j].weight < p[min_index].weight\)) Tj T* (                min_index = j;) Tj T* (        }) Tj T* (        if \(min_index != i\) {) Tj T* (            struct parcel temp = p[i];) Tj T* (            p[i] = p[min_index];) Tj T* (            p[min_index] = temp;) Tj T* (        }) Tj T* (    }) Tj T* (}) Tj T*  T* (int main\(void\)) Tj T* ({) Tj T* (    struct parcel list[3] = {) Tj T* (        {501, 4.5f, {"Madurai", 625001}, {12, 10, 2026}},) Tj T* (        {502, 1.2f, {"Chennai", 600077}, {12, 10, 2026}},) Tj T* (        {503, 2.8f, {"Coimbatore", 641001}, {13, 10, 2026}}) Tj T* (    };) Tj T* (    int i;) Tj T* (    sort_by_weight\(list, 3\);) Tj T* (    for \(i = 0; i < 3; ++i\)) Tj T* (        print_parcel\(&list[i]\);) Tj T* (    printf\("sizeof\(struct parcel\) = %zu bytes\\n", sizeof\(struct parcel\)\);) Tj T* (    return 0;) Tj T* (}) Tj T* ET

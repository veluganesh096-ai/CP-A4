BT 1 0 0 1 0 341.632 Tm /F3 6.8 Tf 8.296 TL (    if \(d.month == 2 &&) Tj T* (        \(d.year % 400 == 0 || \(d.year % 4 == 0 && d.year % 100 != 0\)\)\)) Tj T* (        limit = 29;) Tj T* (    return d.day <= limit;) Tj T* (}) Tj T*  T* (/* Returns 1 when stored; returns 0 for invalid input or a full registry. */) Tj T* (int addPatient\(PatientRegistry *registry, const Patient *patient\)) Tj T* ({) Tj T* (    if \(registry == NULL || patient == NULL\)) Tj T* (        return 0;) Tj T* (    if \(registry->count >= MAX_PATIENTS\)) Tj T* (        return 0;) Tj T* (    if \(memchr\(patient->name, '\\0', sizeof patient->name\) == NULL ||) Tj T* (        memchr\(patient->phone, '\\0', sizeof patient->phone\) == NULL\)) Tj T* (        return 0;) Tj T* (    if \(patient->name[0] == '\\0' || patient->phone[0] == '\\0' ||) Tj T* (        patient->age < 0 || patient->bp.systolic <= 0 ||) Tj T* (        patient->bp.diastolic <= 0 || !valid_date\(patient->visit_date\)\)) Tj T* (        return 0;) Tj T*  T* (    registry->records[registry->count] = *patient;) Tj T* (    registry->count++;) Tj T* (    return 1;) Tj T* (}) Tj T*  T* (int main\(void\)) Tj T* ({) Tj T* (    PatientRegistry clinic = {0};) Tj T* (    Patient sample = {"Anita Rao", "9876543210", 34, {120,80},) Tj T* (                      {19,11,2026}};) Tj T*  T* (    if \(!addPatient\(&clinic, &sample\)\) {) Tj T* (        fprintf\(stderr, "Patient could not be added.\\n"\);) Tj T* (        return 1;) Tj T* (    }) Tj T* (    printf\("Added: %s, age %d, BP %d/%d, patients %zu\\n",) Tj T* (           clinic.records[0].name, clinic.records[0].age,) Tj T* (           clinic.records[0].bp.systolic,) Tj T* (           clinic.records[0].bp.diastolic, clinic.count\);) Tj T* (    return 0;) Tj T* (}) Tj T* ET

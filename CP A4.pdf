 (            Ingredient part = sold->detail.combo.parts[i];) Tj T* (            Item *component = find_item\(items, item_count, part.item_id\);) Tj T* (            component->stock -= quantity * part.quantity;) Tj T* (        }) Tj T* (    } else {) Tj T* (        sold->stock -= quantity;) Tj T* (    }) Tj T*  T* (    if \(!found_sale\) {) Tj T* (        sale_index = *sale_count;) Tj T* (        sales[sale_index].item_id = item_id;) Tj T* (        sales[sale_index].quantity = 0;) Tj T* (        sales[sale_index].revenue = 0.0;) Tj T* (        \(*sale_count\)++;) Tj T* (    }) Tj T* (    sales[sale_index].quantity += quantity;) Tj T* (    sales[sale_index].revenue += sold->price * quantity;) Tj T* (    printf\("Sale accepted: %d x %s = %.2f\\n",) Tj T* (           quantity, sold->name, sold->price * quantity\);) Tj T* (    return 1;) Tj T* (}) Tj T*  T* (static void expiry_warning\(const Item items[], size_t count, Date today\)) Tj T* ({) Tj T* (    size_t i;) Tj T* (    if \(!valid_date\(today\)\) {) Tj T* (        printf\("Invalid current date\\n"\);) Tj T* (        return;) Tj T* (    }) Tj T* (    printf\("Expiry warning \(within 2 days\):\\n"\);) Tj T* (    for \(i = 0; i < count; ++i\) {) Tj T* (        if \(items[i].type == PACKAGED && valid_date\(items[i].detail.expiry\)\) {) Tj T* (            long days_left = days_from_civil\(items[i].detail.expiry\) -) Tj T* (                             days_from_civil\(today\);) Tj T* (            if \(days_left >= 0 && days_left <= 2\) {) Tj T* (                printf\("%s expires %02d/%02d/%04d \(%ld day\(s\) remaining\)\\n",) Tj T* (                       items[i].name, items[i].detail.expiry.day,) Tj T* (                       items[i].detail.expiry.month,) Tj T* (                       items[i].detail.expiry.year, days_left\);) Tj T* (            }) Tj T* (        }) Tj T* (    }) Tj T* (}) Tj T*  T* (static void sort_sales_by_revenue\(Sale sales[], size_t count\)) Tj T* ({) Tj T* (    size_t i;) Tj T* (    for \(i
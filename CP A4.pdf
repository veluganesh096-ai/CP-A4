q
1 0 0 1 51.35433 414.0101 cm
%PreformattedPara
.090196 .129412 .168627 rg
BT 1 0 0 1 0 78.4 Tm /F3 7 Tf 8.54 TL (ALGORITHM ExpiryWarning\(items, today\)) Tj T* (    FOR each item in items) Tj T* (        IF item.type = PACKAGED THEN) Tj T* (            daysLeft <- DATE_DIFFERENCE\(today, item.expiry\)) Tj T* (            IF 0 <= daysLeft <= 2 THEN) Tj T* (                DISPLAY item name, expiry date and daysLeft) Tj T* (            END IF) Tj T* (        END IF) Tj T* (    END FOR) Tj T* (END ALGORITHM) Tj T* ET
Q
 

